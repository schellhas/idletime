# Copy to .env and adjust. Used by docker compose and local development.
POSTGRES_USER=idletime
POSTGRES_PASSWORD=idletime
POSTGRES_DB=idletime

# Used when running the backend outside Docker (make backend-run).
DATABASE_URL=postgres://idletime:idletime@localhost:5432/idletime?sslmode=disable
HTTP_ADDR=:8080

# Host ports published by docker compose (change them if they are already taken).
DB_PORT=5432
BACKEND_PORT=8080
WEB_PORT=3000
